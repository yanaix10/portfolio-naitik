---
import { siteConfig } from "../config";
import { getTechIcon } from "../utils/techIcons";
const hasProjects = siteConfig.projects && siteConfig.projects.length > 0;
---

{
  hasProjects && (
    <section id="projects" class="px-6 py-14 sm:px-12 sm:py-16 md:p-16 lg:p-24">
      <div>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8 lg:gap-16 items-start">
          <div class="lg:col-span-4">
            <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-6xl font-bold text-gray-900">
              Projects
            </h2>
            <div
              class="w-[60px] sm:w-[75px] h-[4px] sm:h-[5px] mt-2 rounded-full"
              style={`background-color: ${siteConfig.accentColor}`}
            />
          </div>

          <div class="lg:col-span-8">
            <div class="space-y-6 sm:space-y-8">
              {siteConfig.projects.map((project, index) => (
                <div class="group relative">
                  <div
                    class="block relative p-5 sm:p-6 md:p-8 bg-gray-50 rounded-xl sm:rounded-2xl border border-gray-200 transition-all duration-300 hover:bg-white hover:shadow-xl hover:border-gray-300 hover:-translate-y-1"
                  >
                    <div class="space-y-4">
                      <div>
                        <!-- Project Index -->
                        <span
                          class="text-xs sm:text-sm font-mono block mb-1.5"
                          style={{ color: siteConfig.accentColor }}
                        >
                          0{index + 1}
                        </span>

                        <!-- Project Title & Action Buttons Row -->
                        <div class="flex items-start sm:items-center justify-between gap-3 sm:gap-4">
                          <div class="flex flex-wrap items-center gap-2 sm:gap-3 min-w-0">
                            <h3 class="text-lg sm:text-xl md:text-2xl font-bold text-gray-900 leading-snug">
                              <a
                                href={project.demo || project.github || project.link}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="hover:text-indigo-600 transition-colors"
                              >
                                {project.name}
                              </a>
                            </h3>

                            {project.inProgress && (
                              <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-mono font-medium bg-amber-50 text-amber-700 border border-amber-200 shrink-0">
                                <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>
                                <span>In Progress</span>
                              </span>
                            )}
                          </div>

                          <!-- Action Buttons: Circular GitHub & Live Demo (Rightmost Column) -->
                          <div class="flex items-center gap-2 shrink-0 ml-auto pt-0.5 sm:pt-0">
                            {project.github && (
                              <a
                                href={project.github}
                                target="_blank"
                                rel="noopener noreferrer"
                                aria-label="GitHub Repository"
                                title="View on GitHub"
                                class="w-8 h-8 sm:w-9 sm:h-9 flex items-center justify-center bg-gray-900 rounded-full text-white transition-all duration-300 hover:bg-gray-700 hover:scale-110 shadow-xs"
                              >
                                <svg
                                  class="w-3.5 h-3.5 sm:w-4 sm:h-4 fill-current"
                                  viewBox="0 0 24 24"
                                >
                                  <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
                                </svg>
                              </a>
                            )}

                            {project.demo && (
                              <a
                                href={project.demo}
                                target="_blank"
                                rel="noopener noreferrer"
                                aria-label={project.inProgress ? "Live Demo (In Progress)" : "Live Demo"}
                                title={project.inProgress ? "Live Demo (In Progress)" : "Live Demo"}
                                class={`relative w-8 h-8 sm:w-9 sm:h-9 flex items-center justify-center rounded-full text-white transition-all duration-300 hover:scale-110 shadow-xs ${
                                  project.inProgress
                                    ? "bg-red-600 hover:bg-red-700"
                                    : "bg-emerald-600 hover:bg-emerald-700"
                                }`}
                              >
                                <svg
                                  class="w-3.5 h-3.5 sm:w-4 sm:h-4"
                                  viewBox="0 0 24 24"
                                  fill="none"
                                  stroke="currentColor"
                                  stroke-width="2"
                                  stroke-linecap="round"
                                  stroke-linejoin="round"
                                >
                                  <circle cx="12" cy="12" r="10" />
                                  <line x1="2" y1="12" x2="22" y2="12" />
                                  <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
                                </svg>
                                <!-- Glowing live indicator dot -->
                                <span class="absolute -top-0.5 -right-0.5 flex h-2.5 w-2.5">
                                  <span
                                    class={`animate-ping absolute inline-flex h-full w-full rounded-full opacity-75 ${
                                      project.inProgress ? "bg-red-400" : "bg-emerald-400"
                                    }`}
                                  ></span>
                                  <span
                                    class={`relative inline-flex rounded-full h-2.5 w-2.5 ring-2 ring-white ${
                                      project.inProgress ? "bg-red-500" : "bg-emerald-500"
                                    }`}
                                  ></span>
                                </span>
                              </a>
                            )}
                          </div>
                        </div>
                      </div>

                      <p class="text-sm sm:text-base md:text-lg text-gray-600 leading-relaxed">
                        {project.description}
                      </p>

                      {project.skills && project.skills.length > 0 && (
                        <div class="flex flex-wrap gap-2 pt-1">
                          {project.skills.map((skill) => {
                            const icon = getTechIcon(skill);
                            return (
                              <span
                                class="inline-flex items-center gap-1.5 sm:gap-2 px-2.5 sm:px-3 py-1 sm:py-1.5 bg-gray-100 text-gray-800 rounded-full text-xs sm:text-sm font-medium hover:bg-gray-200 transition-colors duration-200"
                              >
                                {icon && (
                                  <img
                                    src={icon}
                                    alt=""
                                    class="w-3.5 h-3.5 sm:w-4 sm:h-4 object-contain shrink-0"
                                    loading="lazy"
                                  />
                                )}
                                <span>{skill}</span>
                              </span>
                            );
                          })}
                        </div>
                      )}
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}
