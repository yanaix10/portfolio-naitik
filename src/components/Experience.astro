---
import { siteConfig } from "../config";
const hasExperience = siteConfig.experience && siteConfig.experience.length > 0;
---

{
  hasExperience && (
    <section id="experience" class="px-6 py-14 sm:px-12 sm:py-16 md:p-16 lg:p-24">
      <div>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8 lg:gap-16 items-start">
          <div class="lg:col-span-4">
            <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-6xl font-bold text-gray-900">
              Experience
            </h2>
            <div
              class="w-[60px] sm:w-[75px] h-[4px] sm:h-[5px] mt-2 rounded-full"
              style={`background-color: ${siteConfig.accentColor}`}
            />
          </div>

          <div class="lg:col-span-8">
            <div class="relative space-y-6 sm:space-y-8">
              {siteConfig.experience.map((exp, index) => (
                <div class="relative">
                  {/* Experience card */}
                  <div class="bg-white rounded-xl shadow-xs border border-gray-200/80 p-5 sm:p-6 md:p-8 hover:shadow-md transition-shadow duration-300">
                    <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-1.5 sm:gap-4 mb-4">
                      <div>
                        <h3 class="text-base sm:text-lg md:text-xl font-bold text-gray-900">
                          {exp.title}
                        </h3>
                        <p
                          class="text-sm sm:text-base md:text-lg font-medium mt-0.5"
                          style={`color: ${siteConfig.accentColor}`}
                        >
                          {exp.company}
                        </p>
                      </div>
                      <span class="text-xs sm:text-sm text-gray-500 font-mono shrink-0">
                        {exp.dateRange}
                      </span>
                    </div>

                    <ul class="space-y-2.5">
                      {exp.bullets.map((bullet) => (
                        <li class="flex items-start">
                          <span class="inline-block w-1.5 h-1.5 rounded-full bg-gray-400 mt-2 mr-2.5 sm:mr-3 shrink-0" />
                          <span class="text-xs sm:text-sm md:text-base text-gray-600 leading-relaxed">
                            {bullet}
                          </span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}
