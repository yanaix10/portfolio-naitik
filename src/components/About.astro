---
import { siteConfig } from "../config";
import { getTechIcon } from "../utils/techIcons";
---

<section id="about" class="px-6 py-14 sm:px-12 sm:py-16 md:p-16 lg:p-24">
  <div>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8 lg:gap-16 items-start">
      <div class="lg:col-span-4">
        <h2
          class="text-3xl sm:text-4xl md:text-5xl xl:text-6xl font-bold text-gray-900"
        >
          About Me
        </h2>
        <div
          class="w-[60px] sm:w-[75px] h-[4px] sm:h-[5px] mt-2 rounded-full"
          style={`background-color: ${siteConfig.accentColor}`}
        >
        </div>
      </div>

      <div class="lg:col-span-8 space-y-6 sm:space-y-8">
        <p class="text-base sm:text-lg md:text-xl lg:text-2xl leading-relaxed text-gray-600">
          {siteConfig.aboutMe}
        </p>

        <div class="pt-2 sm:pt-4">
          <div class="flex flex-wrap gap-2 sm:gap-3">
            {
              siteConfig.skills.map((skill) => {
                const icon = getTechIcon(skill);
                return (
                  <span class="inline-flex items-center gap-1.5 sm:gap-2 px-3 sm:px-4 py-1.5 sm:py-2 bg-gray-100 text-gray-800 rounded-full text-xs sm:text-sm md:text-base font-medium hover:bg-gray-200 transition-colors duration-200">
                    {icon && (
                      <img
                        src={icon}
                        alt=""
                        class="w-3.5 h-3.5 sm:w-4.5 sm:h-4.5 object-contain shrink-0"
                        loading="lazy"
                      />
                    )}
                    <span>{skill}</span>
                  </span>
                );
              })
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
